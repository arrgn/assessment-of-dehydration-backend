<!DOCTYPE html>
<html lang="ru">
{{> dehydrationHead}}
<body>
<div class="phone">
  <div class="screen">
    <form
      id="add-form"
      class="detail-body"
      method="post"
      action="{{#if draft}}/dehydration/publish{{else}}/dehydration/add{{/if}}"
    >
      {{#if draft}}<input type="hidden" name="id" value="{{draft.id}}" />{{/if}}

      <label class="media-btn">
        <input type="file" accept="video/*" {{#unless draft}}required{{/unless}} />
        <span>Видео</span>
        <span class="media-plus">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </label>

      <label class="media-btn">
        <input type="file" accept="image/*" {{#unless draft}}required{{/unless}} />
        <span>Фото</span>
        <span class="media-plus">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </label>

      <input
        type="text"
        class="detail-input"
        name="title"
        placeholder="Название"
        value="{{draft.title}}"
        required
      />

      {{#if draft}}
      <textarea
        class="detail-input detail-textarea"
        name="description"
        placeholder="Краткая информация"
        required
      >{{draft.description}}</textarea>

      <input
        type="number"
        class="detail-input"
        name="dehydratingCoefficient"
        placeholder="Коэффициент обезвоживания"
        value="{{draft.dehydratingCoefficient}}"
        min="0"
        required
      />

      <input
        type="number"
        class="detail-input"
        name="maxDehydratingCoefficient"
        placeholder="Максимальный коэффициент"
        value="{{draft.maxDehydratingCoefficient}}"
        min="0"
        required
      />
      {{/if}}
    </form>

    <div class="add-bar">
      <button type="submit" form="add-form" class="detail-btn">
        {{#if draft}}Опубликовать{{else}}Далее{{/if}}
      </button>
    </div>
  </div>

  {{> dehydrationNav}}
</div>
</body>
</html>
