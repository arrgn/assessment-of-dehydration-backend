<!DOCTYPE html>
<html lang="ru">
{{> dehydrationHead}}
<body>
<div class="phone">
  <div class="screen">
    <!-- Скроллящаяся область с формой -->
    <form class="detail-body" action="/add" method="post" onsubmit="return false;">

      <!-- Название -->
      <input
        type="text"
        class="detail-input"
        name="title"
        placeholder="Название"
        value="{{draft.title}}"
      />

      <!-- Кнопки добавления медиа -->
      <label class="media-btn">
        <input type="file" name="video" accept="video/*" />
        <span>Видео</span>
        <span class="media-plus">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </label>

      <label class="media-btn">
        <input type="file" name="photo" accept="image/*" />
        <span>Фото</span>
        <span class="media-plus">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </label>

      <!-- Описание -->
      <textarea
        class="detail-input detail-textarea"
        name="description"
        placeholder="Описание"
      >{{draft.description}}</textarea>

      <!-- Показатель -->
      <input
        type="number"
        class="detail-input"
        name="dehydratingCoefficient"
        placeholder="Коэффициент обезвоживания"
        value="{{draft.dehydratingCoefficient}}"
      />

      <!-- Цена -->
      <input
        type="number"
        class="detail-input"
        name="maxDehydratingCoefficient"
        placeholder="Максимальный коэффициент"
        value="{{draft.maxDehydratingCoefficient}}"
      />

    </form>

  </div>

  {{> dehydrationNav}}
</div>
</body>
</html>
